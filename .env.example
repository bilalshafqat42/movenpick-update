# Movenpick landing page — environment variables.
#
# Copy to .env.local for development. Every variable here is optional
# locally: with none of them set the site runs and renders correctly using
# the content defaults committed in src/content/sections/. The map and the
# call/WhatsApp buttons need their tokens, and content is not editable
# without the admin panel, but nothing breaks.
#
# This app has NO database and NO file storage of its own. Content, images,
# and enquiry storage all belong to the central admin panel — see
# INTEGRATION.md.

# ---------------------------------------------------------------
# Site identity
# ---------------------------------------------------------------

# The site's own absolute base URL, e.g. https://movenpick.ae
#
# REQUIRED IN PRODUCTION, and the only variable whose absence is completely
# invisible: nothing errors and no test fails, but sitemap.xml advertises
# localhost URLs to search engines and every WhatsApp/social share preview
# resolves against localhost and shows nothing. Defaults to
# http://localhost:3000 for development.
SITE_URL=

# Which site this deployment is, from the multi-site admin panel's point of
# view. Sent on every request to the panel. Defaults to "movenpick" if
# unset, but set it explicitly in production: the failure mode of a wrong
# site key is another site's content rendering here, which is worse than an
# error.
SITE_KEY=movenpick

# ---------------------------------------------------------------
# Third-party keys
# ---------------------------------------------------------------

# Retrieve from Mapbox Account -> Access Tokens. Public token.
#
# NEXT_PUBLIC_* variables are compiled into the browser bundle at BUILD
# time, not read at runtime — so changing any of the three below requires a
# rebuild, not just a restart.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Optional: a specific Mapbox Studio style to use instead of the one
# hardcoded in MapSection.js, e.g.
# mapbox://styles/refinedubai/cmt1fmrqn002i01s30m815u3a. Leave blank to
# use the built-in default.
NEXT_PUBLIC_MAPBOX_STYLE_URL=

# WhatsApp number (country code, digits only) for the WhatsApp buttons.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Tap-to-dial number for the "Call now" button (E.164, e.g. +97143300299).
NEXT_PUBLIC_CALL_NUMBER=

# Zapier webhooks receiving contact/chat submissions and slot bookings.
# Kept permanently, alongside the admin panel: they are what makes an
# enquiry survive the panel being unreachable or not yet connected.
ZAPIER_MOVENPICK_LEAD_WEBHOOK=
ZAPIER_MOVENPICK_SLOT_WEBHOOK=

# Shared secret sent as the X-Bot-Secret header on both webhooks above.
# Leave blank to omit the header entirely.
ZAPIER_BOT_SECRET=

# ---------------------------------------------------------------
# Central admin panel connection
# ---------------------------------------------------------------
# Leave this whole block unset to run without the panel. The site then
# serves its committed content defaults: a complete, correct page that
# simply cannot be edited. That is a supported state, not a broken one — it
# is how the site runs locally and how it runs in production before the
# panel is connected.

# The panel's base URL, e.g. https://admin.refinedubai.com
# Setting this is the switch that makes content come from the panel.
# Clearing it switches back, with no code change or redeploy either way.
CONTENT_API_URL=

# The panel's base URL for enquiry submissions. Normally the same host as
# CONTENT_API_URL; separate so content and leads can be migrated
# independently.
LEAD_API_URL=

# Tokens the panel issued for THIS site. Must match what the panel expects.
# If they disagree, the symptom is a 401 that looks exactly like a code bug.
CONTENT_API_TOKEN=
LEAD_INTAKE_TOKEN=

# The panel authenticates to this site's POST /api/revalidate with this, to
# refresh cached content after an editor saves. Must match on both sides.
# Generate with: openssl rand -base64 32
REVALIDATE_SECRET=

# How long content may be served from cache, in seconds. Only a safety net:
# the panel pushes an instant refresh on save, so this bounds how long a
# missed webhook can leave the site stale. Defaults to 300.
#
# MUST NOT be 0. Zero means "never cache", and an uncached fetch inside the
# prerendered homepage makes that page dynamic at runtime, which Next.js
# rejects with a 500 on every request. Values below 1 are clamped to 1.
CONTENT_CACHE_SECONDS=300

# Comma-separated hostnames allowed to serve images — i.e. wherever the
# panel stores uploads. Read at BUILD time, so changing it needs a rebuild.
#
# SET THIS BEFORE EDITORS START UPLOADING IMAGES. Next.js refuses to load an
# image from a host that is not allowlisted here, and it fails abruptly
# rather than gracefully: every page using a replaced image breaks. Nothing
# warns beforehand, because every default is a local /images path, so the
# site looks perfect right up to the first upload.
#
# Example: IMAGE_HOSTS=cdn.refinedubai.com,*.blob.core.windows.net
IMAGE_HOSTS=

# ---------------------------------------------------------------
# Zoho
# ---------------------------------------------------------------
# Two independent modes. Configure whichever you have; both can run at once,
# and both are optional. Every enquiry also goes to the admin panel
# (LEAD_API_URL above) and to Zapier if configured — destinations run
# concurrently and the visitor only sees an error if ALL of them fail.

# --- Mode 1: webhook (RECOMMENDED — simpler) ---
# A Zoho Flow webhook trigger URL. Receives a flat JSON payload with
# consistent field names regardless of which form submitted, so one Flow
# mapping covers the contact form, the chat, and slot bookings.
# No OAuth, no token expiry, and the mapping lives in Flow where a
# non-developer can change it.
ZOHO_WEBHOOK_URL=

# Optional shared secret, sent as the X-Movenpick-Secret header so the Flow
# can reject anything that is not us. Worth setting: a webhook URL on its
# own is a credential sitting in a query string.
ZOHO_WEBHOOK_SECRET=

# --- Mode 2: CRM Leads API (creates records directly in CRM) ---
# Needs a self-client OAuth app in the Zoho API console and a refresh token
# generated once, offline. All three are required together.
ZOHO_CRM_CLIENT_ID=
ZOHO_CRM_CLIENT_SECRET=
ZOHO_CRM_REFRESH_TOKEN=

# Zoho's regional data centre. Common values: com, eu, in, com.au, jp, ca, sa.
# Getting this wrong fails as an authentication error, which does not point at
# the real cause. Defaults to "com".
ZOHO_DC=

# What appears in the CRM Lead Source field. Defaults to "Movenpick Website",
# or "Movenpick Website Chatbot" for chat enquiries.
ZOHO_LEAD_SOURCE=

# Override the Zoho hostnames. Only needed to point a staging deployment at a
# Zoho sandbox, or to test against a stub. Leave blank for production.
ZOHO_ACCOUNTS_BASE_URL=
ZOHO_API_BASE_URL=
